{
  "name": "pokedex",
  "version": "2.0.0",
  "description": "Pokedex using https://pokeapi.co/",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "android:apk": "npm run cap:sync && cd android && gradlew assembleDebug",
    "icons": "capacitor-assets generate --assetPath resources --android --ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelwilker/pokedex.git"
  },
  "author": "Raphael Wilker Mendes Araújo",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "idb-keyval": "^6.3.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^25.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    },
    "editorconfig": {
      "minimatch": "^11.0.5"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
