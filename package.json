{
  "name": "pokedex",
  "version": "2.0.0",
  "description": "Pokedex using https://pokeapi.co/",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelwilker/pokedex.git"
  },
  "author": "Raphael Wilker Mendes Araújo",
  "license": "ISC",
  "dependencies": {
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    },
    "editorconfig": {
      "minimatch": "^11.0.5"
    }
  }
}
